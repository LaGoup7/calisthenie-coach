# Public production origin used by QStash callbacks.
PUBLIC_APP_URL=https://your-kinetik-domain.example

# Generate once with: npm install && npm run push:secrets
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_DELIVERY_SECRET=

# Upstash Redis REST credentials (Vercel Marketplace Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash token
QSTASH_TOKEN=
# Optional regional/custom QStash base. Default: https://qstash.upstash.io
# QSTASH_URL=
